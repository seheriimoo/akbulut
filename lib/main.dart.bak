                      ),
                    ),
                    const SizedBox(height: 12),
                    const Text(
                      'A quiet AI-guided sleep experience.',
                      style: TextStyle(
                        color: AppColors.softWhite,
                        fontSize: 16,
                        fontWeight: FontWeight.w400,
                        height: 1.4,
