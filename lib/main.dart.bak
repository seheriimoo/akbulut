class ChoiceScreen extends StatelessWidget {
  const ChoiceScreen({super.key});

  void _pushPage(BuildContext context, Widget page) {
    Navigator.push(
      context,
      PageRouteBuilder(
        transitionDuration: const Duration(milliseconds: 260),
        reverseTransitionDuration: const Duration(milliseconds: 220),
        pageBuilder: (_, animation, __) => FadeTransition(
          opacity: animation,
          child: page,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        width: double.infinity,
        height: double.infinity,
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [AppColors.bgTop, AppColors.bgBottom],
          ),
        ),
        child: SafeArea(
          child: Padding(
            padding: const EdgeInsets.fromLTRB(20, 16, 20, 20),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _TopBar(
                  title: 'Choose your path',
                  onBack: () => Navigator.pop(context),
                ),
                const SizedBox(height: 14),
                const Text(
                  'Start with guidance, take a quick analysis, or go directly into sleep.',
                  style: TextStyle(
                    color: AppColors.mutedText,
                    fontSize: 14,
                    height: 1.5,
                  ),
                ),
                const SizedBox(height: 24),
                Expanded(
                  child: Column(
                    children: [
                      _ChoiceCard(
                        icon: Icons.chat_bubble_outline_rounded,
                        title: 'AI Sleep Specialist',
                        subtitle:
                            'Talk through your sleep issue and get a suggested session.',
                        onTap: () => _pushPage(context, const AiSleepScreen()),
                      ),
                      const SizedBox(height: 18),
                      _ChoiceCard(
                        icon: Icons.analytics_outlined,
                        title: 'Sleep Analysis',
                        subtitle:
                            'Answer a few quick questions and get a tailored direction.',
                        onTap: () =>
                            _pushPage(context, const SleepAnalysisScreen()),
                      ),
                      const SizedBox(height: 18),
                      _ChoiceCard(
                        icon: Icons.nightlight_round,
                        title: 'Direct Sleep',
                        subtitle:
                            'Start a calm session immediately with minimal friction.',
                        onTap: () =>
                            _pushPage(context, const DirectSleepScreen()),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
