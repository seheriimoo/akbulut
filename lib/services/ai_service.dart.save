import 'dart:convert';
import 'dart:math';
import 'package:http/http.dart' as http;
import 'package:flutter_dotenv/flutter_dotenv.dart';

enum SleepState {
  overthinking,
  workStress,
  relationship,
  futureAnxiety,
  loneliness,
  emotional,
  physical,
  unknown,
}

class AIService {
  static String get apiKey => dotenv.env['OPENAI_API_KEY'] ?? "";

  static final Set<String> _used = {};

  static String _pick(List<String> pool) {
    final available = pool.where((e) => !_used.contains(e)).toList();

    if (available.isEmpty) {
      _used.clear();
      return pool[Random().nextInt(pool.length)];
    }

    final choice = available[Random().nextInt(available.length)];
    _used.add(choice);
    return choice;
  }

  static SleepState detectState(String input) {
    final text = input.toLowerCase();

    if (text.contains("thinking") ||
        text.contains("overthinking") ||
        text.contains("can't stop thinking") ||
        text.contains("cannot stop thinking") ||
        text.contains("mind won't stop") ||
        text.contains("thoughts") ||
        text.contains("kafam") ||
        text.contains("düşünü") ||
        text.contains("aklım") ||
        text.contains("zihnim") ||
        text.contains("susturam") ||
        text.contains("takıldım")) {
      return SleepState.overthinking;
    }

    if (text.contains("work") ||
        text.contains("job") ||
        text.contains("meeting") ||
        text.contains("presentation") ||
        text.contains("deadline") ||
        text.contains("iş") ||
        text.contains("çalış") ||
        text.contains("hastane") ||
        text.contains("mesai") ||
        text.contains("nöbet") ||
        text.contains("yarın") ||
        text.contains("gelecek") ||
        text.contains("yetiştir") ||
        text.contains("sorumluluk")) {
      return SleepState.workStress;
    }

    if (text.contains("stres") ||
        text.contains("stress") ||
        text.contains("anxious") ||
        text.contains("worried") ||
        text.contains("nervous") ||
        text.contains("gergin") ||
        text.contains("bunald") ||
        text.contains("baskı")) {
      return SleepState.emotional;
    }

    if (text.contains("üzgün") ||
        text.contains("sad") ||
        text.contains("kötü") ||
        text.contains("moral")) {
      return SleepState.emotional;
    }

    if (text.contains("tired") ||
        text.contains("body") ||
        text.contains("yorgun") ||
        text.contains("beden")) {
      return SleepState.physical;
    }

    return SleepState.unknown;
  }

  static String buildNormalMessage(
    String userInput,
    SleepState state,
  ) {
    final text = userInput.toLowerCase();

    switch (state) {
      case SleepState.physical:
        return "It sounds like it's been a long day... Is it your body that's tired, or does your mind still feel connected to the day?";

      case SleepState.workStress:
        if (text.contains("work")) {
          return "Work still seems to be taking up some space tonight. What part of it feels hardest to put down?";
        }

        if (text.contains("meeting")) {
          return "Tomorrow's meeting seems to be asking for your attention tonight. What about it keeps pulling you back?";
        }

        if (text.contains("presentation")) {
          return "Your presentation seems to be taking up more space than it needs to tonight. What about it keeps pulling your attention back?";
        }

        return "It seems like today asked a lot from you... You do not need to carry all of it into the rest of the night. What feels hardest to put down right now?";

      case SleepState.overthinking:
        if (text.contains("presentation")) {
          return "Your presentation seems to be taking up more space than it needs to tonight. What about it keeps pulling your attention back?";
        }

        if (text.contains("meeting")) {
          return "Tomorrow's meeting seems to be asking for your attention tonight. What about it keeps pulling you back?";
        }

        if (text.contains("work")) {
          return "Work still seems to be taking up some space tonight. What part of it feels hardest to put down?";
        }

        return _pick([
          "Something seems to be asking for your attention tonight. You do not need to solve it right now. What does your mind keep returning to?",
          "Part of tonight still seems connected to something unfinished. What keeps pulling your attention back?",
          "Your mind sounds a little unwilling to settle just yet. What thought keeps showing up?",
          "Something is still taking up space tonight. What does your mind keep returning to?",
          "It feels like part of your attention is still somewhere else. What keeps drawing you back to it?",
          "Your thoughts seem a little busy tonight. What feels hardest to put down?",
          "Something still feels unresolved tonight. What has been on your mind the most?",
          "Part of you seems to still be holding onto something. What keeps coming back into focus?",
          "Your mind may still be trying to stay with something from today. What keeps returning?",
          "It sounds like something is asking to be noticed tonight. What thought has been staying with you?"
        ]);

      case SleepState.emotional:
        return "Something seems unwilling to leave you alone tonight. You do not need to make sense of it right now. What feels the heaviest at the moment?";

      default:
        return "Sleep seems a little further away tonight... What feels most responsible for keeping you awake right now?";
    }
  }

  static String buildNarrowMessage(
    String userInput,
    String historyText,
    SleepState state,
  ) {
    final context = "$historyText $userInput".toLowerCase();

    switch (state) {
      case SleepState.workStress:
      case SleepState.overthinking:
        if (context.contains("meeting")) {
          return "Tomorrow's meeting still seems to be asking for your attention tonight. Nothing more needs to be figured out right now. For now, it can wait until morning.";
        }

        if (context.contains("presentation")) {
          return "It sounds like part of you is still trying to make sure everything goes well tomorrow. Nothing more needs to be figured out tonight. For now, it can stay where it is.";
        }

        if (context.contains("work")) {
          return "Work still seems to be asking for some of your attention tonight. Nothing more needs to be figured out right now. For now, it can wait until morning.";
        }

        if (context.contains("mistake") ||
            context.contains("pressure") ||
            context.contains("nervous") ||
            context.contains("worried")) {
          return "It sounds like you're trying to make sure everything goes right. Nothing more needs to be figured out tonight. For now, it can stay where it is.";
        }

        return "Part of you is still trying to stay with it tonight. Nothing more needs to be figured out right now. For now, it can stay where it is.";

      case SleepState.physical:
        return "Your body sounds ready for rest, but something may still be keeping you alert. What feels hardest to let go of right now?";

      case SleepState.emotional:
        return "Whatever happened today seems to still be sitting with you. You do not need to understand it right now. What part feels the heaviest?";

      default:
        return "It makes sense that your mind keeps returning to it. Tonight, you do not need to solve any of it. What feels hardest to put down right now?";
    }
  }

  static String buildFinalMessage(String historyText) {
    final context = historyText.toLowerCase();

    if (context.contains("meeting")) {
      return "Tomorrow's meeting still seems to be holding some of your attention. Nothing needs to be figured out tonight. I'm preparing a personalized Nocta experience for you.";
    }

    if (context.contains("presentation")) {
      return "Tomorrow's presentation still seems to be holding some of your attention. Nothing needs to be figured out tonight. I'm preparing a personalized Nocta experience for you.";
    }

    if (context.contains("work")) {
      return "Work may still feel unfinished tonight. Nothing more is needed from you right now. I'm preparing a personalized Nocta experience for you.";
    }

    return "For tonight, nothing more needs to be figured out. What brought you here can stay where it is for a little while. I'm preparing a personalized Nocta experience for you.";
  }

  static Future<String?> enhanceWithAI(String baseText) async {
    if (apiKey.isEmpty) return null;

    final uri = Uri.parse("https://api.openai.com/v1/chat/completions");

    try {
      final response = await http.post(
        uri,
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer $apiKey",
        },
        body: jsonEncode({
          "model": "gpt-4o-mini",
          "messages": [
            {
              "role": "system",
              "content": """
Rewrite the following text in a more natural, soft, human way.

Rules:
- Keep EXACT same meaning
- Keep same number of sentences
- Do not expand
- Do not explain
- Make it feel less repetitive and more human
"""
            },
            {"role": "user", "content": baseText}
          ],
          "temperature": 0.8,
          "max_tokens": 80,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(utf8.decode(response.bodyBytes));
        return data["choices"][0]["message"]["content"];
      }
    } catch (_) {}

    return null;
  }

  static Future<String> generateReply({
    required String userInput,
    required int aiMessageCount,
    required List<String> conversationHistory,
    required SleepState? conversationState,
  }) async {
    final state = conversationState ?? detectState(userInput);
    final historyText = conversationHistory.join(" ");

    print("HISTORY = $historyText");
    print("AI MESSAGE COUNT = $aiMessageCount");
    print("STATE = $state");

    if (aiMessageCount == 0) {
      return buildNormalMessage(userInput, state);
    }

    if (aiMessageCount == 1) {
      return buildNarrowMessage(userInput, historyText, state);
    }

    return buildFinalMessage(historyText);
  }
}
